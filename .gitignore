Cargo.lock

# SDKWork local runtime state
.runtime/
**/.runtime/
**/node_modules/
/target/
**/target/
!.env.example
!.env.*.example
!.env.postgres.example
dist/
**/dist/
coverage/
**/.pnpm-store/
**/.sdkwork/local/
**/.sdkwork/secrets/
**/.sdkwork/cache/
**/.sdkwork/tmp/
**/.sdkwork/dart/pub-cache/
**/.sdkwork/manual-backups/
**/.sdkwork/sdkwork-generator-changes.json
**/.sdkwork/sdkwork-generator-manifest.json
**/.sdkwork/sdkwork-generator-report.json

# Common runtime/build artifacts (auto-aligned)
*.sqlite-shm
*.sqlite-wal
**/test-results/
.turbo/
**/.turbo/
*.tsbuildinfo
**/.cache/


# SDKWork local-only and generated artifacts
.env
.env.*
!.env.example
!.env.*.example
**/build/
*.log
.DS_Store
Thumbs.db

# Runtime-generated env config (modified by local dev server)
**/public/runtime-env.json
**/etc/browser/runtime-env.*.json

# Workspace junk / temp files and directories
_tmp_*/
_tmp_*
.workbuddy/

# TypeScript build output in source directories (compiled alongside source)
**/src/**/*.js.map
**/src/**/*.d.ts.map

# TypeScript build output at package root (e.g. types.js, types.d.ts)
**/packages/**/*.js
**/packages/**/*.js.map
**/packages/**/*.d.ts
**/packages/**/*.d.ts.map

# Generated SDK build output (rebuilt by regenerating SDK, not hand-edited)
sdks/**/generated/server-openapi/src/**/*.js
sdks/**/generated/server-openapi/src/**/*.js.map
sdks/**/generated/server-openapi/src/**/*.d.ts
sdks/**/generated/server-openapi/src/**/*.d.ts.map
sdks/**/composed/*.js
sdks/**/composed/*.js.map
sdks/**/composed/*.d.ts
sdks/**/composed/*.d.ts.map
# Local one-off audit scratch (do not commit)
.tmp-family-audit/

# Compiler emit is ignored only where the file is emit BY DEFINITION. The broad
# `**/src/**/*.js` / `**/src/**/*.d.ts` globs are gone: `.gitignore` cannot express "ignore
# this only when a same-stem .ts sibling exists", so they also hid authored declarations
# (`vite-env.d.ts`, `styles.d.ts`, module shims) and real mini-program source under `src/`.
# The sibling rule is enforced against tracked files by
# `sdkwork-specs/tools/check-repository-baseline-content.mjs` instead.
