      "binary": "sdkwork-api-appstore-standalone-gateway"
    },
    "storefrontRenderer": {
      "package": "sdkwork-appstore-pc",
      "script": "_sdkwork:client:browser"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-appstore-standalone-gateway",
            "binary": "sdkwork-api-appstore-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "appstore-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-appstore-pc",
            "bindEnv": "SDKWORK_APPSTORE_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "browserDeliveries": [
          {
            "id": "appstore-adaptive-web",
            "applicationRoot": "apps/sdkwork-appstore-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "appstore-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-appstore-pc",
                "script": "dev",
                "defaultPort": 4210,
                "portEnv": "SDKWORK_APPSTORE_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-appstore-h5",
                "script": "dev",
                "defaultPort": 4211,
                "portEnv": "SDKWORK_APPSTORE_H5_INTERNAL_DEV_PORT",
                "env": {}
              }
            }
          }
        ],
        "accessEndpoints": [
          {
            "id": "application-ui",
            "kind": "user-interface",
            "source": {
              "processId": "storefront-renderer"
            },
            "path": "/",
            "primary": true,
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web"
            ]
          },
          {
            "id": "application-api",
            "kind": "service",
            "source": {
              "surfaceId": "application.public-ingress"
            },
            "path": "/",
            "runtimeTargets": [
              "browser"
            ]
          },
          {
            "id": "application-api-reference",
            "kind": "api-reference",
            "source": {
              "surfaceId": "application.public-ingress"
            },
            "path": "/openapi.json",
            "runtimeTargets": [
              "browser"
            ]
          },
          {
            "id": "application-health",
            "kind": "health",
            "source": {
              "surfaceId": "application.public-ingress"
            },
            "path": "/healthz",
            "runtimeTargets": [
              "browser"
            ]
