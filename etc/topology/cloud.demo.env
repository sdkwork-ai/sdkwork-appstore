# cloud.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_appstore_demo`
# and (when the base profile uses Redis) a dedicated Redis logical DB index / key prefix so no cache
# key (rate-limit, session, idempotency, ...) ever collides with another shared-redis environment.
# NOTE: demo MUST use an independent database schema `sdkwork_appstore_demo` for isolation.
# NOTE: if Redis is used, demo MUST target a dedicated Redis logical DB index / distinct key prefix so it never collides with other environments on shared Redis.
SDKWORK_APPSTORE_DEPLOYMENT_PROFILE=cloud
SDKWORK_APPSTORE_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_APPSTORE_PROFILE_ID=cloud.demo
SDKWORK_ENVIRONMENT=demo
SDKWORK_CORS_ALLOWED_ORIGINS=https://appstore-demo.sdkwork.com,http://appstore-demo.sdkwork.com,https://appstore-demo.birdcoder.com,http://appstore-demo.birdcoder.com,https://appstore-demo.dtupay.com,http://appstore-demo.dtupay.com,https://appstore-demo.noaper.com,http://appstore-demo.noaper.com,https://appstore-demo.sdkwork.cn,http://appstore-demo.sdkwork.cn,https://appstore-demo.birdcoder.cn,http://appstore-demo.birdcoder.cn,https://appstore-demo.dtupay.cn,http://appstore-demo.dtupay.cn,https://appstore-demo.noaper.cn,http://appstore-demo.noaper.cn,https://appstore-demo.skubc.com,http://appstore-demo.skubc.com,https://appstore-demo.skubc.cn,http://appstore-demo.skubc.cn,https://appstore-demo.zowalk.com,http://appstore-demo.zowalk.com,https://appstore-demo.zowalk.cn,http://appstore-demo.zowalk.cn,https://appstore-demo.offer86.com,http://appstore-demo.offer86.com,https://appstore-demo.offer86.cn,http://appstore-demo.offer86.cn,https://appstore-demo.86offer.com,http://appstore-demo.86offer.com,https://appstore-demo.86offer.cn,http://appstore-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_APPSTORE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_APPSTORE_APPLICATION_PUBLIC_HTTP_URL=http://appstore-demo.sdkwork.com:3900
VITE_SDKWORK_APPSTORE_APPLICATION_PUBLIC_HTTP_URL=http://appstore-demo.sdkwork.com:3900
VITE_SDKWORK_APPSTORE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_APPSTORE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_APPSTORE_WEB_DEV_INGRESS_BIND=127.0.0.1:4208
SDKWORK_APPSTORE_PC_INTERNAL_DEV_PORT=4210
SDKWORK_APPSTORE_H5_INTERNAL_DEV_PORT=4211


