SDKWORK_ENVIRONMENT=development
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4208,http://localhost:4208,https://appstore-dev.sdkwork.com,http://appstore-dev.sdkwork.com,https://appstore-dev.birdcoder.com,http://appstore-dev.birdcoder.com,https://appstore-dev.dtupay.com,http://appstore-dev.dtupay.com,https://appstore-dev.noaper.com,http://appstore-dev.noaper.com,https://appstore-dev.sdkwork.cn,http://appstore-dev.sdkwork.cn,https://appstore-dev.birdcoder.cn,http://appstore-dev.birdcoder.cn,https://appstore-dev.dtupay.cn,http://appstore-dev.dtupay.cn,https://appstore-dev.noaper.cn,http://appstore-dev.noaper.cn,https://appstore-dev.skubc.com,http://appstore-dev.skubc.com,https://appstore-dev.skubc.cn,http://appstore-dev.skubc.cn,https://appstore-dev.zowalk.com,http://appstore-dev.zowalk.com,https://appstore-dev.zowalk.cn,http://appstore-dev.zowalk.cn,https://appstore-dev.offer86.com,http://appstore-dev.offer86.com,https://appstore-dev.offer86.cn,http://appstore-dev.offer86.cn,https://appstore-dev.86offer.com,http://appstore-dev.86offer.com,https://appstore-dev.86offer.cn,http://appstore-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_APPSTORE_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18090
SDKWORK_APPSTORE_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18090
SDKWORK_APPSTORE_INTERNAL_PC_RENDERER_BIND=0.0.0.0:18092
SDKWORK_SKILLS_APP_API_BASE_URL=http://127.0.0.1:3900
VITE_SDKWORK_SKILLS_APP_API_BASE_URL=http://127.0.0.1:3900
SDKWORK_MCP_APP_API_BASE_URL=http://127.0.0.1:3900
VITE_SDKWORK_MCP_APP_API_BASE_URL=http://127.0.0.1:3900
VITE_SDKWORK_APPSTORE_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_APPSTORE_ENVIRONMENT=development
VITE_SDKWORK_RUNTIME_TARGET=browser
VITE_SDKWORK_APPSTORE_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:4208

# Standalone gateway PostgreSQL profile (IAM + appstore persistence).
# Copy .env.postgres.example to .env.postgres for credentials, then run:
#   pnpm db:postgres:init
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
# Load password from .env.postgres (copy from .env.postgres.example).
# SDKWORK_DATABASE_PASSWORD=
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10
SDKWORK_DATABASE_ACQUIRE_TIMEOUT=5

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_APPSTORE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_APPSTORE_WEB_DEV_INGRESS_BIND=127.0.0.1:4208
SDKWORK_APPSTORE_PC_INTERNAL_DEV_PORT=4210
SDKWORK_APPSTORE_H5_INTERNAL_DEV_PORT=4211

