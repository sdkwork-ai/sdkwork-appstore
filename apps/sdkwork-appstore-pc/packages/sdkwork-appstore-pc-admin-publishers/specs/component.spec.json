{
  "schemaVersion": 1,
  "kind": "sdkwork.component.spec",
  "component": {
    "name": "@sdkwork/appstore-pc-admin-publishers",
    "displayName": "SDKWork App Store PC Admin Publishers",
    "version": "1.0.0",
    "type": "typescript-package",
    "root": "apps/sdkwork-appstore-pc/packages/sdkwork-appstore-pc-admin-publishers",
    "domain": "appstore",
    "capability": "admin-publishers",
    "surface": "backend-admin",
    "languages": [
      "typescript"
    ],
    "generated": false,
    "status": "active",
    "manifests": [
      "package.json",
      "specs/component.spec.json"
    ]
  },
  "canonicalSpecs": [
    {
      "file": "BACKEND_UI_SPEC.md",
      "path": "../../../../../sdkwork-specs/BACKEND_UI_SPEC.md",
      "purpose": "Operator page structure, permission hints, and backend-admin package placement."
    },
    {
      "file": "APP_PC_ARCHITECTURE_SPEC.md",
      "path": "../../../../../sdkwork-specs/APP_PC_ARCHITECTURE_SPEC.md",
      "purpose": "pc-admin-* capability package boundary and dependency direction."
    },
    {
      "file": "I18N_SPEC.md",
      "path": "../../../../../sdkwork-specs/I18N_SPEC.md",
      "purpose": "Package-owned locale fragments under src/i18n/<locale>/appstore/admin."
    },
    {
      "file": "PAGINATION_SPEC.md",
      "path": "../../../../../sdkwork-specs/PAGINATION_SPEC.md",
      "purpose": "Cursor paging over publisher listing analytics."
    }
  ],
  "contracts": {
    "publicExports": [
      "."
    ],
    "providedPorts": [
      {
        "port": "appstore.pc.admin.publishers.module",
        "description": "Publisher capability module: routes, navigation metadata, and locale namespaces."
      }
    ],
    "requiredPorts": [
      {
        "port": "appstore.pc.admin.service-ports",
        "description": "publishers service port from @sdkwork/appstore-pc-admin-core."
      },
      {
        "port": "appstore.pc.admin.shell",
        "description": "Operator UI kit, shell context, and query/command hooks from @sdkwork/appstore-pc-admin-shell."
      }
    ],
    "sdkDependencies": [],
    "sdkClients": [],
    "permissionComposition": {
      "inheritanceMode": "module-catalog-with-overrides",
      "applicationModule": {
        "manifestRef": "../../../../specs/iam.module.manifest.json"
      },
      "moduleCatalogRefs": [
        {
          "moduleId": "appstore",
          "manifestRef": "../../../../specs/iam.module.manifest.json",
          "inheritPermissions": true,
          "inheritRoles": true
        }
      ],
      "bootstrapAccessTokenScope": {
        "inheritFrom": "sdkwork.app.config.json#backend.accessTokenPermissionScope",
        "supplement": [],
        "overrideReplace": false
      },
      "routePermissionHints": {
        "inheritFromOpenApi": true,
        "inheritFromModuleManifests": true,
        "overrides": [
          {
            "routeId": "publishers-verification",
            "permissions": [
              "appstore.publishers.admin"
            ]
          },
          {
            "routeId": "publishers-analytics",
            "permissions": [
              "appstore.analytics.publisher"
            ]
          }
        ]
      },
      "consumerPolicy": {
        "forbidLocalPermissionCatalogForDependencyDomains": true,
        "allowExplicitOverridesOnly": true,
        "allowFrontendHintsWithoutServerDuplication": true
      }
    },
    "dependencyApiExports": [],
    "dependencyApiSurfaces": []
  },
  "verification": {
    "commands": [
      "pnpm --dir apps/sdkwork-appstore-pc typecheck"
    ]
  }
}
