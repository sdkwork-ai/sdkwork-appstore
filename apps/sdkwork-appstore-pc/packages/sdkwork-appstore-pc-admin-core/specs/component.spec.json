    "version": "1.0.0",
    "type": "typescript-package",
    "root": "apps/sdkwork-appstore-pc/packages/sdkwork-appstore-pc-admin-core",
    "domain": "appstore",
    "capability": "admin-core",
    "surface": "backend-admin",
    "languages": [
      "typescript"
    ],
    "generated": false,
    "status": "active",
    "manifests": [
      "package.json",
      "specs/component.spec.json"
    ]
  },
  "canonicalSpecs": [
    {
      "file": "APP_PC_ARCHITECTURE_SPEC.md",
      "path": "../../../../../sdkwork-specs/APP_PC_ARCHITECTURE_SPEC.md",
      "purpose": "Explicit backend-admin runtime boundary and package dependency direction."
    },
    {
      "file": "BACKEND_UI_SPEC.md",
      "path": "../../../../../sdkwork-specs/BACKEND_UI_SPEC.md",
      "purpose": "Operator UI authorization, package placement, and admin capability inventory."
    },
    {
      "file": "APP_SDK_INTEGRATION_SPEC.md",
      "path": "../../../../../sdkwork-specs/APP_SDK_INTEGRATION_SPEC.md",
      "purpose": "Backend SDK injection in an explicit admin surface."
    },
    {
      "file": "IAM_SPEC.md",
      "path": "../../../../../sdkwork-specs/IAM_SPEC.md",
      "purpose": "Permission codes and platform-administrator role evaluation."
    }
  ],
  "contracts": {
    "publicExports": [
      "."
    ],
    "providedPorts": [
      {
        "port": "appstore.pc.admin.sdk-client",
        "description": "Single legal construction point for the generated App Store backend SDK inside the backend-admin surface."
      },
      {
        "port": "appstore.pc.admin.service-ports",
        "description": "One backend-admin service port per backend domain namespace (dashboard, moderation, listings, catalog, publishers, market)."
      },
      {
        "port": "appstore.pc.admin.access",
        "description": "Backend-admin permission catalog, permission evaluation, and the headless route access guard."
      },
      {
        "port": "appstore.pc.admin.routes",
        "description": "Route and capability-module descriptor contracts consumed by pc-admin-shell and implemented by every pc-admin-* capability package."
      }
    ],
    "requiredPorts": [],
    "sdkDependencies": [
