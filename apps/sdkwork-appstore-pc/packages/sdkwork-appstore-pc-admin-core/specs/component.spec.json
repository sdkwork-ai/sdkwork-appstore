        "workspace": "sdkwork-appstore-backend-sdk",
        "surface": "backend-api",
        "credentialMode": "authenticated-backend-admin"
      }
    ],
    "sdkClients": [
      "@sdkwork/appstore-backend-sdk"
    ],
    "permissionComposition": {
