{
  "name": "sdkwork-appstore-pc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "dev:browser": "vite --configLoader native",
    "_sdkwork:client:browser": "vite --configLoader native",
    "dev:server": "tsx server.ts",
    "dev:desktop": "vite --port=3000 --host=0.0.0.0",
    "dev:tablet-ipados": "vite --port=3000 --host=0.0.0.0",
    "dev:tablet-android": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:staging": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment staging",
    "build:demo": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment demo",
    "build:prod": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment prod",
    "build:desktop": "vite build",
    "build:desktop:prod": "vite build --mode standalone.production",
    "build:tablet-ipados": "vite build",
    "build:tablet-ipados:prod": "vite build --mode standalone.production",
    "build:tablet-android": "vite build",
    "build:tablet-android:prod": "vite build --mode standalone.production",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:config": "tsc --noEmit",
    "build:dev": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment dev",
    "build:test": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment test",
    "build:dev:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment dev --deployment-profile cloud",
    "build:test:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment test --deployment-profile cloud",
    "build:staging:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment staging --deployment-profile cloud",
    "build:demo:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment demo --deployment-profile cloud",
    "build:prod:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment prod --deployment-profile cloud"
  },
  "dependencies": {
    "@sdkwork/agents-app-sdk": "workspace:*",
    "@sdkwork/appstore-app-sdk": "workspace:*",
    "@sdkwork/appstore-backend-sdk": "workspace:*",
    "@sdkwork/appstore-pc-admin-core": "workspace:*",
    "@sdkwork/appstore-pc-admin-monitor": "workspace:*",
    "@sdkwork/appstore-pc-ai-hub": "workspace:*",
    "@sdkwork/appstore-pc-app-detail": "workspace:*",
    "@sdkwork/appstore-pc-apps": "workspace:*",
    "@sdkwork/appstore-pc-category": "workspace:*",
    "@sdkwork/appstore-pc-charts": "workspace:*",
    "@sdkwork/appstore-pc-collection": "workspace:*",
    "@sdkwork/appstore-pc-console-settings": "workspace:*",
    "@sdkwork/appstore-pc-core": "workspace:*",
    "@sdkwork/appstore-pc-discover": "workspace:*",
    "@sdkwork/appstore-pc-events": "workspace:*",
    "@sdkwork/appstore-pc-games": "workspace:*",
    "@sdkwork/appstore-pc-host": "workspace:*",
    "@sdkwork/appstore-pc-library": "workspace:*",
    "@sdkwork/appstore-pc-product": "workspace:*",
    "@sdkwork/appstore-pc-publisher": "workspace:*",
    "@sdkwork/appstore-pc-runtime": "workspace:*",
    "@sdkwork/appstore-pc-search": "workspace:*",
    "@sdkwork/appstore-pc-shell": "workspace:*",
    "@sdkwork/appstore-pc-updates": "workspace:*",
    "@sdkwork/appstore-pc-wishlist": "workspace:*",
    "@sdkwork/auth-pc-react": "workspace:*",
    "@sdkwork/auth-runtime-pc-react": "workspace:*",
    "@sdkwork/comments-app-sdk": "workspace:*",
    "@sdkwork/iam-app-sdk": "workspace:*",
    "@sdkwork/iam-contracts": "workspace:*",
    "@sdkwork/iam-credential-entry": "workspace:*",
    "@sdkwork/iam-react": "workspace:*",
    "@sdkwork/iam-runtime": "workspace:*",
    "@sdkwork/mcp-app-sdk": "workspace:*",
    "@sdkwork/sdk-common": "workspace:*",
    "@sdkwork/skills-app-sdk": "workspace:*",
    "@sdkwork/utils": "workspace:*",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "i18next": "^26.3.6",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "@sdkwork/appstore-pc-commons": "workspace:*",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss-animate": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "catalog:"
  }
}
