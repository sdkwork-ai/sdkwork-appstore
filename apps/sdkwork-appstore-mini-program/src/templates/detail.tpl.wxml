<!-- Shared detail-page skeleton: binds loading / error / detail. -->
<template name="detailPage">
  <view class="wp-detail-page">
    <view wx:if="{{loading}}" class="wp-state">加载中…</view>
    <view wx:elif="{{error}}" class="wp-state wp-state--error">{{error}}</view>
    <block wx:elif="{{detail}}">
      <view class="wp-detail-header">
        <view class="wp-detail-icon">{{detail.name[0]}}</view>
        <view class="wp-detail-title-wrap">
          <view class="wp-detail-name">{{detail.name}}</view>
          <view class="wp-detail-developer">{{detail.developer}}</view>
          <view class="wp-detail-meta">
            <view wx:if="{{detail.rating > 0}}" class="wp-detail-rating">{{detail.rating}}★</view>
            <view class="wp-detail-price">{{detail.pricingModel === 'PAID' ? '付费' : '免费'}}</view>
          </view>
        </view>
      </view>

      <view class="wp-detail-action-wrap">
        <button
          class="wp-detail-action"
          size="mini"
          loading="{{acquiring}}"
          disabled="{{acquiring}}"
          bindtap="onPrimaryAction"
        >{{acquired ? '再次打开' : (detail.pricingModel === 'PAID' ? '购买' : '获取')}}</button>
        <view wx:if="{{!authed}}" class="wp-detail-action-hint" bindtap="onLoginTap">登录后可获取应用</view>
      </view>

      <view wx:if="{{detail.description}}" class="wp-detail-section">
        <view class="wp-detail-section-title">关于此应用</view>
        <text class="wp-detail-description">{{detail.description}}</text>
      </view>

      <view wx:if="{{detail.whatsNew}}" class="wp-detail-section">
        <view class="wp-detail-section-title">新功能</view>
        <text class="wp-detail-description">{{detail.whatsNew}}</text>
      </view>

      <view wx:if="{{detail.similar.length > 0}}" class="wp-detail-section">
        <view class="wp-detail-section-title">你可能也会喜欢</view>
        <view
          class="wp-list-item"
          wx:for="{{detail.similar}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onItemTap"
          hover-class="wp-list-item--hover"
        >
          <view class="wp-item-icon">{{item.name[0]}}</view>
          <view class="wp-item-main">
            <view class="wp-item-name">{{item.name}}</view>
            <view class="wp-item-developer">{{item.developer}}</view>
          </view>
        </view>
      </view>
    </block>
  </view>
</template>
