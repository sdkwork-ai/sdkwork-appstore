<view wx:if="{{!authed}}" class="auth-gate">
  <view class="auth-gate__title">登录后可查看</view>
  <button class="auth-gate__button" bindtap="onLoginTap">去登录</button>
</view>
<block wx:else>
  <view class="section-header">
    <text class="section-header__text">我的分类</text>
    <button class="section-header__action" size="mini" bindtap="onCategoryCreate">+ 新建</button>
  </view>
  <view wx:if="{{categories.length === 0}}" class="wp-state">还没有分类，点击上方新建</view>
  <view class="wp-list-item" wx:for="{{categories}}" wx:key="id">
    <view class="wp-item-icon">{{item.name[0]}}</view>
    <view class="wp-item-main" data-id="{{item.id}}" bindtap="onCategoryTap">
      <view class="wp-item-name">{{item.name}}</view>
      <view class="wp-item-developer">{{item.itemCount}} 个应用</view>
    </view>
    <view class="wp-item-action" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onCategoryDelete">删除</view>
  </view>

  <view class="section-header">
    <text class="section-header__text">分享链接</text>
    <button class="section-header__action" size="mini" bindtap="onShareCreate">生成链接</button>
  </view>
  <view wx:if="{{shares.length === 0}}" class="wp-state">还没有分享链接</view>
  <view class="wp-list-item" wx:for="{{shares}}" wx:key="id">
    <view class="wp-item-main">
      <view class="wp-item-name">/store/{{item.shareToken}}</view>
    </view>
    <view class="wp-item-action" data-token="{{item.shareToken}}" bindtap="onShareCopy">复制</view>
    <view class="wp-item-action wp-item-action--danger" data-id="{{item.id}}" bindtap="onShareRevoke">撤销</view>
  </view>
</block>
