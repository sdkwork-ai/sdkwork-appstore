/* SDKWork App Store 小程序首页 v2 — 对齐 UI_DESIGN_SPEC 设计 token。
   工艺层：应用图标带顶部高光 + 内发光环；精选卡带水印字形 + 径向辉光 +
   玻璃拟态徽章；排版用编辑式字阶（Today 风格）。 */

.page {
  min-height: 100vh;
  background-color: #f5f5f7;
  padding-bottom: 64rpx;
}

/* ── 编辑式页头 ─────────────────────────────── */

.header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 40rpx 32rpx 12rpx;
}

.header__date {
  font-size: 20rpx;
  font-weight: 600;
  color: #8e8e93;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.header__title {
  margin-top: 6rpx;
  font-size: 56rpx;
  font-weight: 800;
  color: #1d1d1f;
  letter-spacing: -1.5rpx;
  line-height: 1.15;
}

.header__actions {
  display: flex;
  gap: 16rpx;
  padding-bottom: 6rpx;
}

.header__action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #ffffff;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.header__action--accent {
  background: linear-gradient(140deg, #0071e3 8%, #5856d6 92%);
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(0, 113, 227, 0.32);
}

.header__action--hover {
  transform: scale(0.94);
  opacity: 0.85;
}

.header__action-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: #0071e3;
}

.header__action-plus {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1;
  transition: transform 200ms ease;
}

.header__action-plus--open {
  transform: rotate(45deg);
}

/* ── 新建下拉菜单 ───────────────────────────── */

.create-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 55;
}

.create-menu {
  position: fixed;
  top: 200rpx;
  right: 32rpx;
  z-index: 60;
  width: 420rpx;
  padding: 12rpx;
  animation: create-in 180ms ease-out;
}

@keyframes create-in {
  from {
    opacity: 0;
    transform: translateY(-12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.create-menu__item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
}

.create-menu__item--hover {
  background-color: #f5f5f7;
}

.create-menu__text {
  min-width: 0;
  flex: 1;
}

.create-menu__name {
  font-size: 27rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.create-menu__desc {
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 21rpx;
  color: #8e8e93;
}

/* ── 骨架屏 ─────────────────────────────────── */

.skeleton {
  margin: 24rpx 32rpx 0;
  border-radius: 28rpx;
  background: linear-gradient(90deg, #ececf0 0%, #f7f7f9 50%, #ececf0 100%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.skeleton--hero {
  height: 380rpx;
}

.skeleton--rail {
  height: 200rpx;
}

.skeleton--grid {
  height: 320rpx;
}

.skeleton--list {
  height: 280rpx;
}

.skeleton-row {
  display: flex;
  gap: 36rpx;
  padding: 36rpx 32rpx 0;
}

.skeleton-row .skeleton {
  margin: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* ── 加载失败 ───────────────────────────────── */

.error {
  margin: 24rpx 32rpx;
  padding: 48rpx 32rpx;
  border-radius: 28rpx;
  background-color: #ffffff;
  text-align: center;
}

.error__text {
  display: block;
  font-size: 26rpx;
  color: #ff3b30;
}

.error__retry {
  margin-top: 24rpx;
  background-color: #0071e3;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 32rpx;
}

/* ── 工艺图标：渐变底 + 顶部高光 + 内发光环 ──── */

.craft-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.craft-icon--sm {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
}

.craft-icon--lg {
  width: 116rpx;
  height: 116rpx;
  border-radius: 28rpx;
}

.craft-icon--circle {
  border-radius: 50%;
}

.craft-icon__gloss {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: inherit;
  background: radial-gradient(
    130% 100% at 16% 6%,
    rgba(255, 255, 255, 0.4),
    rgba(255, 255, 255, 0) 56%
  );
}

.craft-icon__letter {
  position: relative;
  z-index: 2;
  color: #ffffff;
  font-weight: 800;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.18);
}

.craft-icon .craft-icon__letter {
  font-size: 40rpx;
}

.craft-icon--sm .craft-icon__letter {
  font-size: 32rpx;
}

.craft-icon--lg .craft-icon__letter {
  font-size: 50rpx;
}

.craft-icon--md .craft-icon__letter {
  font-size: 38rpx;
}

.g0 { background: linear-gradient(140deg, #0071e3 8%, #5856d6 92%); }
.g1 { background: linear-gradient(140deg, #34c759 8%, #00c7be 92%); }
.g2 { background: linear-gradient(140deg, #ff9500 8%, #ff3b30 92%); }
.g3 { background: linear-gradient(140deg, #af52de 8%, #ff2d55 92%); }
.g4 { background: linear-gradient(140deg, #5ac8fa 8%, #0071e3 92%); }
.g5 { background: linear-gradient(140deg, #ff2d55 8%, #ff9500 92%); }

/* ── 玻璃拟态 ───────────────────────────────── */

.glass {
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16rpx);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: #ffffff;
}

/* ── 精选编辑卡（Hero / 合集 / 活动共用） ─────── */

.feature {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 356rpx;
  margin: 0 32rpx;
  padding: 28rpx 30rpx;
  border-radius: 32rpx;
  color: #ffffff;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.14);
}

.feature--hover {
  transform: scale(0.985);
}

.feature__glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(
    95% 75% at 88% -4%,
    rgba(255, 255, 255, 0.24),
    rgba(255, 255, 255, 0) 62%
  );
}

.feature__watermark {
  position: absolute;
  right: -18rpx;
  bottom: -56rpx;
  font-size: 300rpx;
  font-weight: 800;
  line-height: 1;
  color: rgba(255, 255, 255, 0.13);
  transform: rotate(-12deg);
}

.feature__watermark--sm {
  font-size: 180rpx;
  right: -14rpx;
  bottom: -36rpx;
}

.feature__top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.feature__star {
  font-size: 20rpx;
  color: #ffd60a;
  letter-spacing: 0;
}

.feature__body {
  position: relative;
  z-index: 2;
  margin-top: auto;
}

.feature__identity {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.feature__named {
  min-width: 0;
  flex: 1;
}

.feature__name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.feature__developer {
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  opacity: 0.82;
}

.feature__cta {
  display: inline-block;
  width: fit-content;
  margin-top: 24rpx;
  padding: 14rpx 40rpx;
  border-radius: 40rpx;
  background-color: #ffffff;
  color: #1d1d1f;
  font-size: 24rpx;
  font-weight: 700;
}

/* 合集 / 活动的紧凑变体 */

.feature--compact {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;
  width: 340rpx;
  height: 220rpx;
  margin: 0 0 0 24rpx;
  padding: 24rpx;
}

.rail .feature--compact:first-child {
  margin-left: 32rpx;
}

.feature__tag {
  position: relative;
  z-index: 2;
  width: fit-content;
}

.feature__compact-body {
  position: relative;
  z-index: 2;
}

.feature__compact-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.feature__compact-sub {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 20rpx;
  opacity: 0.8;
}

.feature--event {
  background: linear-gradient(140deg, #ff9500 8%, #ff3b30 92%);
  box-shadow: 0 16rpx 40rpx rgba(255, 59, 48, 0.22);
}

/* 无精选时的品牌回退卡 */

.feature--fallback {
  justify-content: flex-start;
  margin-top: 24rpx;
  background: linear-gradient(140deg, #0071e3 8%, #5856d6 92%);
}

.feature-fallback__badge {
  position: relative;
  z-index: 2;
  width: fit-content;
}

.feature-fallback__title {
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.feature-fallback__subtitle {
  position: relative;
  z-index: 2;
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.feature-fallback__cta {
  position: relative;
  z-index: 2;
  display: inline-block;
  width: fit-content;
  margin-top: 28rpx;
  padding: 14rpx 40rpx;
  border-radius: 40rpx;
  background-color: #ffffff;
  color: #1d1d1f;
  font-size: 24rpx;
  font-weight: 700;
}

.hero-fallback__cta--hover {
  transform: scale(0.96);
}

/* ── 轮播指示点 ─────────────────────────────── */

.hero {
  padding-top: 24rpx;
}

.hero__swiper {
  height: 380rpx;
}

.hero__dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.hero__dot {
  width: 12rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background-color: rgba(0, 0, 0, 0.16);
  transition: all 300ms ease;
}

.hero__dot--active {
  width: 40rpx;
  background-color: #0071e3;
}

/* ── 分区通用 ───────────────────────────────── */

.section {
  margin-top: 48rpx;
}

.section__title {
  padding: 0 32rpx 18rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #1d1d1f;
  letter-spacing: -0.8rpx;
}

.section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-right: 32rpx;
}

.section__more {
  font-size: 24rpx;
  font-weight: 500;
  color: #0071e3;
}

.section__more--hover {
  opacity: 0.75;
}

.card {
  background-color: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.rail {
  display: flex;
  white-space: nowrap;
}

/* ── 分类圆形入口 ───────────────────────────── */

.category {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  width: 128rpx;
  margin-left: 34rpx;
}

.category--hover {
  opacity: 0.8;
}

.category__label {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  font-size: 22rpx;
  font-weight: 500;
  color: #6e6e73;
}

/* ── 榜单速览 ───────────────────────────────── */

.chart {
  margin: 0 32rpx;
  overflow: hidden;
}

.chart__row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 26rpx;
}

.chart__row--hover {
  background-color: #f5f5f7;
}

.chart__row + .chart__row {
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.chart__rank {
  width: 48rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #8e8e93;
  font-variant-numeric: tabular-nums;
}

.chart__rank--top {
  color: #0071e3;
}

.chart__main {
  flex: 1;
  min-width: 0;
}

.chart__name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.chart__developer {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8e8e93;
}

.chart__rating {
  font-size: 22rpx;
  font-weight: 600;
  color: #6e6e73;
}

.chart__chevron {
  font-size: 30rpx;
  color: #c7c7cc;
  font-weight: 600;
}

/* ── 为你推荐：双列卡片 ─────────────────────── */

.rec-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  padding: 0 32rpx;
}

.rec {
  width: 314rpx;
  padding: 24rpx;
}

.rec--hover {
  transform: scale(0.97);
}

.rec__head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.rec__named {
  flex: 1;
  min-width: 0;
}

.rec__name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.rec__developer {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8e8e93;
}

.rec__rating {
  margin-top: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #6e6e73;
}

.rec__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.rec__price {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background-color: rgba(52, 199, 89, 0.13);
  color: #34c759;
  font-size: 20rpx;
  font-weight: 700;
}

.rec__get {
  padding: 10rpx 34rpx;
  border-radius: 32rpx;
  background-color: #0071e3;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
}

/* ── 快捷入口 ───────────────────────────────── */

.quicknav {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  padding: 0 32rpx;
}

.quicknav__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  width: 160rpx;
  padding: 28rpx 0 24rpx;
}

.quicknav__item--hover {
  transform: scale(0.95);
}

.quicknav__name {
  font-size: 23rpx;
  font-weight: 600;
  color: #1d1d1f;
}

/* ── 页脚 ───────────────────────────────────── */

.footer {
  margin-top: 56rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8e8e93;
}

.rec__price--paid {
  background-color: rgba(255, 149, 0, 0.14);
  color: #ff9500;
}
