.page {
  min-height: 100vh;
  background-color: #f5f5f7;
  padding-bottom: 48rpx;
}

.hero {
  padding: 64rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: #ffffff;
}

.hero__title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.hero__subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 24rpx 32rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
  border: 1rpx solid #e5e7eb;
}

.status__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #9ca3af;
}

.status--ready .status__dot {
  background-color: #10b981;
}

.status--error .status__dot {
  background-color: #ef4444;
}

.status__text {
  font-size: 26rpx;
  color: #374151;
}

.section-title {
  margin: 32rpx 32rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
}

.grid__item {
  width: calc(50% - 24rpx);
  margin: 8rpx 12rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  border: 1rpx solid #ececf0;
  box-sizing: border-box;
}

.grid__item--hover {
  background-color: #f5f5f7;
}

.grid__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.grid__desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6e6e73;
}

.footer {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}
