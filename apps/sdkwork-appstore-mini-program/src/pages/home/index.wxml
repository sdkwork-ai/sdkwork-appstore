<view class="page">
  <view class="hero">
    <view class="hero__title">SDKWork 应用商店</view>
    <view class="hero__subtitle">小程序精选应用市场</view>
  </view>

  <view class="status {{status === 'ready' ? 'status--ready' : 'status--error'}}">
    <view class="status__dot"></view>
    <text class="status__text">{{statusLabel}}</text>
  </view>

  <view class="section-title">能力入口</view>
  <view class="grid">
    <view
      class="grid__item"
      wx:for="{{capabilities}}"
      wx:key="key"
      data-name="{{item.name}}"
      bindtap="onCapabilityTap"
      hover-class="grid__item--hover"
    >
      <view class="grid__name">{{item.name}}</view>
      <view class="grid__desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="footer">SDKWork App Store · 小程序端</view>
</view>
