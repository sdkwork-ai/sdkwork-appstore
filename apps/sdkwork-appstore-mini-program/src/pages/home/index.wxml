<view class="page">
  <!-- 编辑式页头：Today 日期 + 大标题 + 圆形操作 -->
  <view class="header">
    <view class="header__meta">
      <view class="header__date">{{todayLine}}</view>
      <view class="header__title">发现</view>
    </view>
    <view class="header__actions">
      <view
        class="header__action header__action--accent"
        hover-class="header__action--hover"
        bindtap="onCreateMenuToggle"
        aria-label="新建"
        aria-haspopup="menu"
        aria-expanded="{{createMenuOpen}}"
      >
        <view class="header__action-plus {{createMenuOpen ? 'header__action-plus--open' : ''}}">＋</view>
      </view>
      <view class="header__action" hover-class="header__action--hover" bindtap="onChartsTap" aria-label="排行榜">
        <view class="header__action-icon">榜</view>
      </view>
      <view class="header__action" hover-class="header__action--hover" bindtap="onSearchTap" aria-label="搜索">
        <view class="header__action-icon">⌕</view>
      </view>
    </view>
  </view>

  <!-- 新建下拉菜单：新建应用 / 新建官网 / 新建宣传应用 -->
  <view wx:if="{{createMenuOpen}}" class="create-mask" bindtap="onCreateMenuClose"></view>
  <view wx:if="{{createMenuOpen}}" class="create-menu card" aria-label="新建">
    <view
      class="create-menu__item"
      wx:for="{{createTargets}}"
      wx:key="type"
      data-type="{{item.type}}"
      bindtap="onCreateTargetTap"
      hover-class="create-menu__item--hover"
    >
      <view class="craft-icon craft-icon--sm g{{index}}">
        <view class="craft-icon__gloss"></view>
        <view class="craft-icon__letter">{{item.name[2]}}</view>
      </view>
      <view class="create-menu__text">
        <view class="create-menu__name">{{item.name}}</view>
        <view class="create-menu__desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 加载失败 -->
  <view wx:if="{{error}}" class="error">
    <text class="error__text">{{error}}</text>
    <button class="error__retry" size="mini" bindtap="onRetry">重试</button>
  </view>

  <!-- 分区骨架屏 -->
  <block wx:elif="{{loading}}">
    <view class="skeleton skeleton--hero"></view>
    <view class="skeleton-row">
      <view class="skeleton skeleton--circle" wx:for="{{[0,1,2,3,4]}}" wx:key="*this"></view>
    </view>
    <view class="skeleton skeleton--rail"></view>
    <view class="skeleton skeleton--grid"></view>
    <view class="skeleton skeleton--list"></view>
  </block>

  <block wx:else>
    <!-- 精选轮播：分层编辑卡（水印 + 辉光 + 玻璃徽章） -->
    <view wx:if="{{heroApps.length > 0}}" class="hero">
      <swiper
        class="hero__swiper"
        autoplay
        circular
        interval="5000"
        duration="450"
        bindchange="onHeroSwipe"
      >
        <swiper-item wx:for="{{heroApps}}" wx:key="id">
          <view
            class="feature feature--g{{item.g}}"
            data-id="{{item.id}}"
            bindtap="onHeroTap"
            hover-class="feature--hover"
          >
            <view class="feature__glow"></view>
            <view class="feature__watermark">{{item.name[0]}}</view>
            <view class="feature__top">
              <view class="glass">{{heroCurrent === index ? '今日精选' : '编辑推荐'}}</view>
              <view wx:if="{{item.rating > 0}}" class="glass feature__star">★ {{item.rating}}</view>
            </view>
            <view class="feature__body">
              <view class="feature__identity">
                <view class="craft-icon craft-icon--lg">
                  <view class="craft-icon__gloss"></view>
                  <view class="craft-icon__letter">{{item.name[0]}}</view>
                </view>
                <view class="feature__named">
                  <view class="feature__name">{{item.name}}</view>
                  <view class="feature__developer">{{item.developer}}</view>
                </view>
              </view>
              <view class="feature__cta">立即查看</view>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view class="hero__dots">
        <view
          class="hero__dot {{heroCurrent === index ? 'hero__dot--active' : ''}}"
          wx:for="{{heroApps}}"
          wx:key="id"
        ></view>
      </view>
    </view>
    <view wx:else class="feature feature--fallback">
      <view class="feature__glow"></view>
      <view class="feature__watermark">S</view>
      <view class="feature-fallback__badge glass">Today</view>
      <view class="feature-fallback__title">发现精彩应用</view>
      <view class="feature-fallback__subtitle">编辑精选与智能推荐，帮你找到下一款必备应用</view>
      <view class="feature-fallback__cta" hover-class="hero-fallback__cta--hover" bindtap="onSearchTap">立即探索</view>
    </view>

    <!-- 分类入口：工艺圆形 -->
    <view wx:if="{{categories.length > 0}}" class="section">
      <view class="section__title">分类</view>
      <scroll-view class="rail" scroll-x enable-flex>
        <view
          class="category"
          wx:for="{{categories}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bindtap="onCategoryTap"
          hover-class="category--hover"
        >
          <view class="craft-icon craft-icon--circle craft-icon--md g{{item.g}}">
            <view class="craft-icon__gloss"></view>
            <view class="craft-icon__letter">{{item.name[0]}}</view>
          </view>
          <view class="category__label">{{item.name}}</view>
        </view>
      </scroll-view>
    </view>

    <!-- 编辑精选合集 -->
    <view wx:if="{{collections.length > 0}}" class="section">
      <view class="section__title">编辑精选合集</view>
      <scroll-view class="rail" scroll-x enable-flex>
        <view
          class="feature feature--compact feature--g{{item.g}}"
          wx:for="{{collections}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onCollectionTap"
          hover-class="feature--hover"
        >
          <view class="feature__glow"></view>
          <view class="feature__watermark feature__watermark--sm">{{item.name[0]}}</view>
          <view class="glass feature__tag">合集</view>
          <view class="feature__compact-body">
            <view class="feature__compact-name">{{item.name}}</view>
            <view class="feature__compact-sub">{{item.description || '编辑精心挑选'}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 限时活动 -->
    <view wx:if="{{events.length > 0}}" class="section">
      <view class="section__title">限时活动</view>
      <scroll-view class="rail" scroll-x enable-flex>
        <view
          class="feature feature--compact feature--event"
          wx:for="{{events}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onEventTap"
          hover-class="feature--hover"
        >
          <view class="feature__glow"></view>
          <view class="feature__watermark feature__watermark--sm">{{item.title[0]}}</view>
          <view class="glass feature__tag">限时</view>
          <view class="feature__compact-body">
            <view class="feature__compact-name">{{item.title}}</view>
            <view class="feature__compact-sub">{{item.endsLabel ? '截止 ' + item.endsLabel : '正在进行'}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 榜单速览 -->
    <view wx:if="{{chartApps.length > 0}}" class="section">
      <view class="section__head">
        <view class="section__title">榜单速览</view>
        <view class="section__more" hover-class="section__more--hover" bindtap="onChartsTap">完整榜单 ›</view>
      </view>
      <view class="chart card">
        <view
          class="chart__row"
          wx:for="{{chartApps}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onChartAppTap"
          hover-class="chart__row--hover"
        >
          <view class="chart__rank {{index < 3 ? 'chart__rank--top' : ''}}">{{index + 1}}</view>
          <view class="craft-icon craft-icon--sm g{{item.g}}">
            <view class="craft-icon__gloss"></view>
            <view class="craft-icon__letter">{{item.name[0]}}</view>
          </view>
          <view class="chart__main">
            <view class="chart__name">{{item.name}}</view>
            <view class="chart__developer">{{item.developer}}</view>
          </view>
          <view wx:if="{{item.rating > 0}}" class="chart__rating">★ {{item.rating}}</view>
          <view class="chart__chevron">›</view>
        </view>
      </view>
    </view>

    <!-- 为你推荐：双列卡片 -->
    <view wx:if="{{recommendations.length > 0}}" class="section">
      <view class="section__title">为你推荐</view>
      <view class="rec-grid">
        <view
          class="rec card"
          wx:for="{{recommendations}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onRecommendationTap"
          hover-class="rec--hover"
        >
          <view class="rec__head">
            <view class="craft-icon g{{item.g}}">
              <view class="craft-icon__gloss"></view>
              <view class="craft-icon__letter">{{item.name[0]}}</view>
            </view>
            <view class="rec__named">
              <view class="rec__name">{{item.name}}</view>
              <view class="rec__developer">{{item.developer}}</view>
            </view>
          </view>
          <view class="rec__rating" wx:if="{{item.rating > 0}}">★ {{item.rating}}</view>
          <view class="rec__footer">
            <view class="rec__price">免费</view>
            <view class="rec__get">获取</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="section">
      <view class="section__title">快捷入口</view>
      <view class="quicknav">
        <view
          class="quicknav__item card"
          wx:for="{{capabilities}}"
          wx:key="key"
          data-name="{{item.name}}"
          data-path="{{item.path}}"
          bindtap="onCapabilityTap"
          hover-class="quicknav__item--hover"
        >
          <view class="craft-icon craft-icon--circle craft-icon--md g{{index % 6}}">
            <view class="craft-icon__gloss"></view>
            <view class="craft-icon__letter">{{item.name[0]}}</view>
          </view>
          <view class="quicknav__name">{{item.name}}</view>
        </view>
      </view>
    </view>

    <view class="footer">SDKWork App Store · 每天发现新应用</view>
  </block>
</view>
