.page {
  min-height: 100vh;
  background-color: #f5f5f7;
  padding: 48rpx 32rpx;
}

.card {
  border-radius: 28rpx;
  background-color: #ffffff;
  padding: 48rpx 40rpx;
}

.card__title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.card__subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6e6e73;
}

.error {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background-color: #fef2f2;
  color: #ef4444;
  font-size: 24rpx;
}

.field {
  margin-top: 24rpx;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  background-color: #f5f5f7;
  font-size: 28rpx;
}

.submit {
  margin-top: 36rpx;
  border-radius: 40rpx;
  background-color: #4f46e5;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
