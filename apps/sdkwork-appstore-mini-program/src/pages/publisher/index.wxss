@import "../../templates/list.wxss";
.auth-gate {
  padding: 96rpx 32rpx;
  text-align: center;
}
.auth-gate__title {
  font-size: 28rpx;
  color: #6e6e73;
  margin-bottom: 24rpx;
}
.auth-gate__button {
  background-color: #0071e3;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 40rpx;
}


/* 新建面板（首页加号菜单进入 / 页面悬浮按钮） */
.create {
  margin: 24rpx 32rpx 0;
  padding: 28rpx;
}

.create__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.create__subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8e8e93;
  line-height: 1.5;
}

.create__input {
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background-color: #f5f5f7;
  font-size: 26rpx;
  color: #1d1d1f;
}

.create__actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 24rpx;
}

.create__cancel {
  background-color: #f0f0f2;
  color: #1d1d1f;
  font-size: 24rpx;
  border-radius: 32rpx;
}

.create__submit {
  background-color: #0071e3;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 32rpx;
}

.create__error {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #ff3b30;
}

/* 悬浮新建按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 72rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(140deg, #0071e3 8%, #5856d6 92%);
  box-shadow: 0 12rpx 28rpx rgba(0, 113, 227, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

.fab--hover {
  transform: scale(0.94);
}

.fab__plus {
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1;
}
