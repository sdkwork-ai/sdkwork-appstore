{
  "schemaVersion": 3,
  "kind": "sdkwork.app",
  "app": {
    "key": "sdkwork-appstore-h5",
    "name": "SDKWork App Store H5",
    "displayName": "SDKWork App Store",
    "description": "SDKWork marketplace H5 client for discovering, installing, publishing, and operating applications on mobile browsers.",
    "vendor": "SDKWork",
    "officialWebsiteUrl": "https://sdkwork.com/apps/sdkwork-appstore-h5",
    "supportUrl": "https://sdkwork.com/support",
    "privacyPolicyUrl": "https://sdkwork.com/privacy",
    "termsOfServiceUrl": "https://sdkwork.com/terms",
    "appType": "APP_REACT",
    "versionSource": "package.json",
    "identifiers": {
      "containerImage": "registry.sdkwork.com/apps/sdkwork-appstore-h5"
    }
  },
  "backend": {
    "profileKey": "backend-root-admin",
    "ownerMode": "tenant",
    "grantMode": "current",
    "platform": "WEB",
    "appId": "sdkwork-appstore-h5",
    "organizationId": "0",
    "tenantId": "100001",
    "accessTokenPermissionScope": [
      "iam:self"
    ]
  },
  "runtime": {
    "family": "mobile",
    "framework": "react-h5",
    "runtimes": [
      "WEB",
      "H5"
    ],
    "deliveryModes": [
      "WEB_URL"
    ],
    "defaultPlatform": "H5",
    "defaultArchitecture": "universal",
    "supportedDeploymentProfiles": [
      "cloud",
      "standalone"
    ],
    "defaultDeploymentProfile": "cloud"
  },
  "media": {
    "icons": {
      "primary": {
        "id": "sdkwork-appstore-h5-primary-icon",
        "type": "ICON",
        "purpose": "PRIMARY",
        "platform": "H5",
        "format": "PNG",
        "width": 1024,
        "height": 1024,
        "enabled": true,
        "url": "https://cdn.sdkwork.com/apps/sdkwork-appstore/assets/icon-1024.png",
        "metadata": {
          "generatedPlaceholder": true
        }
      },
      "platform": []
    },
    "screenshots": [],
    "previews": []
  },
  "publish": {
    "status": "DRAFT",
    "platforms": [
      "H5"
    ],
    "installPlatforms": [
      "H5"
    ],
    "installSkill": false
  },
  "artifacts": {
    "installConfig": {
      "packages": []
    }
  },
  "release": {
    "currentVersion": "1.0.0",
    "defaultChannel": "BETA",
    "latest": {
      "BETA": "1.0.0"
    },
    "notes": [
      {
        "version": "1.0.0",
        "channel": "BETA",
        "current": true,
        "packageIds": []
      }
    ]
  },
  "security": {
    "checksumRequired": true,
    "signatureRequired": true,
    "sbomRequired": true
  },
  "devApp": {
    "sourceRoot": "apps/sdkwork-appstore-h5",
    "build": {
      "targets": [
        "browser",
        "h5"
      ]
    }
  },
  "metadata": {
    "domain": "appstore",
    "capability": "store",
    "standardOwner": "sdkwork-appstore",
    "deploymentConfig": "etc/sdkwork.deployment.config.json"
  }
}
